rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: readable and writable by staff
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Team messages collection: readable and writable by staff
    match /team_messages/{messageId} {
      allow read, write: if true;
    }

    // Users collection: readable and writable by staff
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
